<?xml version="1.0"?>
<!DOCTYPE kpartgui>
<transition tag="frei0r.omni-swipe" id="frei0r.omni-swipe" type="videotransition">
    <name>OmniSwipe</name>
    <description>A Swiss Army knife for swipe and slide transitions.</description>
    <author>acc4commissions and Grok 4.3</author>

    <parameter type="animated" name="position" max="1000" min="0" default="0=0;%out=1" factor="1000">
        <name>Swipe position (progress)</name>
    </parameter>

    <parameter type="list" name="axis_a" default="0" paramlist="0;1;2">
        <name>Clip A Axis</name>
        <paramlistdisplay>+0,+90,+180</paramlistdisplay>
    </parameter>

    <parameter type="double" name="wheel_a" max="180" min="0" default="0">
        <name>Clip A Axis Wheel</name>
    </parameter>

    <parameter type="list" name="axis_b" default="0" paramlist="0;1;2">
        <name>Clip B Axis</name>
        <paramlistdisplay>+0,+90,+180</paramlistdisplay>
    </parameter>

    <parameter type="double" name="wheel_b" max="180" min="0" default="180">
        <name>Clip B Axis Wheel</name>
    </parameter>

    <parameter type="list" name="clipb_behavior" default="1" paramlist="0;1;2">
        <name>Clip B Behavior</name>
        <paramlistdisplay>Static,Move,Fade</paramlistdisplay>
    </parameter>

    <parameter type="double" name="speed_curve" max="100" min="0" default="0">
        <name>Speed Curve (%)</name>
    </parameter>

        <parameter type="double" name="gentle_arrival" max="100" min="0" default="0">
        <name>Gentle Arrival (%)</name>
    </parameter>

    <parameter type="double" name="motion_blur" max="100" min="0" default="0">
        <name>Motion Blur (%)</name>
    </parameter>

    <parameter type="bool" name="edge_smoothing" default="1">
        <name>Edge Smoothing</name>
    </parameter>

    <parameter type="bool" name="invert" default="0">
        <name>Invert</name>
    </parameter>

    <preview>
        <parameter name="position">0=0;-1=1</parameter>
    </preview>
</transition>
